{
  "rewrites": [
    {
      "source": "/tcg",
      "destination": "/api/tcg"
    },
    {
      "source": "/s/:id",
      "destination": "/api/share?t=s&id=:id"
    },
    {
      "source": "/o/:id",
      "destination": "/api/share?t=o&id=:id"
    },
    {
      "source": "/j/:id",
      "destination": "/api/share?t=j&id=:id"
    },
    {
      "source": "/saison/:id",
      "destination": "/api/share?t=s&id=:id&page=1"
    },
    {
      "source": "/org/:id",
      "destination": "/api/share?t=o&id=:id&page=1"
    },
    {
      "source": "/joueur/:id",
      "destination": "/api/share?t=j&id=:id&page=1"
    },
    {
      "source": "/((?!api/|_blob/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/tcg.js": {
      "includeFiles": "tcg-files/**"
    }
  },
  "headers": [
    {
      "source": "/tcg-files/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/tcg-files/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}